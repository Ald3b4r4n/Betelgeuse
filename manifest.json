{
  "manifest_version": 3,
  "name": "Betelgeuse",
  "version": "0.1.0",
  "description": "Bloqueia anúncios (pre-roll, overlays, banners e popups) em xvideos.com.",
  "homepage_url": "https://github.com/Ald3b4r4n/Betelgeuse",
  "minimum_chrome_version": "88",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["*://*.xvideos.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.xvideos.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page.js"],
      "matches": ["*://*.xvideos.com/*"]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Betelgeuse"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
